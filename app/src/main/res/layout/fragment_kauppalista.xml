<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutUusi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light"
    tools:context=".Kauppalista">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@color/darkgreen"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txvListaOtsikko"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:fontFamily="sans-serif-smallcaps"
        android:letterSpacing="0.2"
        android:text="Kauppalista"
        android:textAlignment="center"
        android:textColor="@color/light"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTieto"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="160dp"
        android:ems="10"
        android:fontFamily="sans-serif-smallcaps"
        android:hint="Kirjoita tähän"
        android:inputType="textMultiLine"
        android:textColor="@color/text"
        android:textColorHint="@color/green"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/btnLisaa"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnLisaa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:backgroundTint="#00F7EBDB"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textColorLink="@color/green"
        android:textSize="20sp"
        app:icon="@drawable/baseline_add_24"
        app:iconSize="30dp"
        app:iconTint="@color/green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editTieto"
        app:layout_constraintTop_toTopOf="@+id/editTieto" />

    <Button
        android:id="@+id/btnPoista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="130dp"
        android:backgroundTint="@color/light"
        app:icon="@drawable/baseline_delete_24"
        app:iconSize="60dp"
        app:iconTint="@color/terracotta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnLisaa"
        app:layout_constraintStart_toEndOf="@+id/scrollView" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPoista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLisaa">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTulostieto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:hint="Kauppalista on tyhjä"
                android:padding="5dp"
                android:fontFamily="sans-serif-smallcaps"
                android:textAlignment="textStart"
                android:textColor="@color/text"
                android:textColorHint="@color/green"
                android:textColorLink="@color/green"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
