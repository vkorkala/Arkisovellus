        <item name="colorOnPrimary">@color/white</item>

        <!-- Korostus -->
        <item name="colorSecondary">@color/beige</item>
        <item name="colorOnSecondary">@color/text</item>

        <!-- Vaalea korostuspinta -->
        <item name="colorSecondaryContainer">@color/lightgreen</item>
